{"type":"message","id":"5b7687c3","parentId":"0fe53c64","timestamp":"2026-05-19T02:32:19.689Z","message":{"role":"toolResult","toolCallId":"call_bb0d431e90d34a24b8a1e4f2","toolName":"read","content":[{"type":"text","text":"import os\nfrom tigeropen.quote.quote_client import QuoteClient\nfrom tigeropen.trade.trade_client import TradeClient\nfrom tigeropen.common.consts import Region, Env\n\n# ==================== 从 OpenClaw .env 读取全局配置（无需硬编码） ====================\nTIGER_ID = os.getenv(\"TIGER_ID\")\nTIGER_PRIVATE_KEY = os.getenv(\"TIGER_PRIVATE_KEY\")\nTIGER_MODE = os.getenv(\"TIGER_MODE\", \"simulation\")\nTIGER_SIM_ACCOUNT = os.getenv(\"TIGER_SIMULATION_ACCOUNT\")\nTIGER_LIVE_ACCOUNT = os.getenv(\"TIGER_LIVE_ACCOUNT\")\n\n# 固定新加坡区参数（不可修改）\nREGION = Region.SG\n\n# ==================== 域名配置（已验证） ====================\n# 生产环境: https://openapi.tigerfintech.com/gateway\n# 模拟环境: https://openapi-sandbox.tigerfintech.com/gateway\n# ⚠️ openapi-sgp.itigerup.com 域名不存在，不要使用\n\ndef _get_env_and_account():\n    \"\"\"根据模式返回环境和账户\"\"\"\n    if TIGER_MODE == \"simulation\":\n        return Env.SANDBOX_SG, TIGER_SIM_ACCOUNT\n    else:\n        return Env.PRODUCTION_SG, TIGER_LIVE_ACCOUNT\n\n# ==================== 自动初始化客户端 ====================\ndef get_tiger_clients():\n    \"\"\"自动区分模拟/实盘，返回行情、交易双客户端\"\"\"\n    env, account = _get_env_and_account()\n\n    # 交易客户端\n    trade_client = TradeClient(\n        tiger_id=TIGER_ID,\n        account=account,\n        private_key=TIGER_PRIVATE_KEY,\n        env=env,\n        region=REGION\n    )\n\n    # 行情客户端\n    quote_client = QuoteClient(\n        tiger_id=TIGER_ID,\n        private_key=TIGER_PRIVATE_KEY,\n        env=env,\n        region=REGION\n    )\n\n    return trade_client, quote_client\n\ntrade_cli, quote_cli = get_tiger_clients()\n\n# ==================== 可直接调用工具函数 ====================\ndef get_stock_brief(symbol: str):\n    \"\"\"\n    获取单只股票实时行情摘要\n    :param symbol: 股票代码 例:AAPL,TSLA\n    \"\"\"\n    res = quote_cli.get_briefs([symbol])\n    if not res:\n        return f\"【失败】未获取到 {symbol} 行情数据\"\n    data = res[0]\n    return (\n        f\"【{symbol} 实时行情】\\n\"\n        f\"最新价：{data.latest_price}\\n\"\n        f\"涨跌：{data.change} ({data.change_percent:.2f}%)\\n\"\n        f\"开盘价：{data.open}\\n\"\n        f\"最高价：{data.high}\\n\"\n        f\"最低价：{data.low}\\n\"\n        f\"成交量：{data.volume}\"\n    )\n\ndef get_stock_quote(symbol: str):\n    \"\"\"\n    获取单只股票详细报价\n    :param symbol: 股票代码 例:AAPL,TSLA\n    \"\"\"\n    try:\n        res = quote_cli.get_stock_quote([symbol])\n        if not res:\n            return f\"【失败】未获取到 {symbol} 行情数据\"\n        data = res[0]\n        return (\n            f\"【{symbol} 实时报价】\\n\"\n            f\"最新价：{data.latest_price}\\n\"\n            f\"涨跌：{data.change} ({data.change_percent:.2f}%)\\n\"\n            f\"开盘价：{data.open}\\n\"\n            f\"最高价：{data.high}\\n\"\n            f\"最低价：{data.low}\\n\"\n            f\"成交量：{data.volume}\\n\"\n            f\"成交额：{data.amount}\"\n        )\n    except Exception as e:\n        return f\"【错误】{str(e)}\"\n\ndef get_account_info():\n    \"\"\"获取账户总资产、可用资金、持仓市值\"\"\"\n    assets = trade_cli.get_assets()\n    if not assets:\n        return \"【失败】未获取到账户信息\"\n    account = assets[0]\n    summary = account.summary\n    return (\n        f\"【新加坡区{TIGER_MODE}账户信息】\\n\"\n        f\"总资产(净值)：${summary.net_liquidation:,.2f}\\n\"\n        f\"可用资金：${summary.cash:,.2f}\\n\"\n        f\"购买力：${summary.buying_power:,.2f}\\n\"\n        f\"持仓市值：${summary.gross_position_value:,.2f}\\n\"\n        f\"已实现盈亏：${summary.realized_pnl:,.2f}\\n\"\n        f\"未实现盈亏：${summary.unrealized_pnl:,.2f}\"\n    )\n\ndef get_positions():\n    \"\"\"查询当前全部持仓\"\"\"\n    pos_list = trade_cli.get_positions()\n    if not pos_list:\n        return \"当前无任何持仓\"\n    text = \"【当前持仓列表】\\n\"\n    for p in pos_list:\n        text += f\"{p.symbol} | 数量：{p.quantity} | 成本价：{p.cost_price} | 盈亏：{p.unrealized_pnl}\\n\"\n    return text\n\ndef place_order_limit(symbol: str, price: float, quantity: int, action: str = \"BUY\"):\n    \"\"\"\n    限价单下单\n    :param symbol: 标的代码\n    :param price: 限价价格\n    :param quantity: 股数\n    :param action: BUY / SELL\n    \"\"\"\n    try:\n        order = trade_cli.create_order(\n            account=trade_cli.account,\n            symbol=symbol,\n            action=action,\n            order_type=\"LMT\",\n            quantity=quantity,\n            limit_price=price\n        )\n        trade_cli.place_order(order)\n        return f\"【下单成功】订单ID：{order.id} | {action} {symbol} 限价{price} 数量{quantity}股\"\n    except Exception as e:\n        return f\"【下单失败】{str(e)}\"\n\ndef place_order_market(symbol: str, quantity: int, action: str = \"BUY\"):\n    \"\"\"\n    市价单下单\n    :param symbol: 标的代码\n    :param quantity: 股数\n    :param action: BUY / SELL\n    \"\"\"\n    try:\n        order = trade_cli.create_order(\n            account=trade_cli.account,\n            symbol=symbol,\n            action=action,\n            order_type=\"MKT\",\n            quantity=quantity\n        )\n        trade_cli.place_order(order)\n        return f\"【下单成功】订单ID：{order.id} | {action} {symbol} 市价 数量{quantity}股\"\n    except Exception as e:\n        return f\"【下单失败】{str(e)}\"\n\ndef cancel_order(order_id: str):\n    \"\"\"根据订单ID撤单\"\"\"\n    try:\n        res = trade_cli.cancel_order(order_id)\n        return f\"【撤单成功】订单{order_id}已撤销\"\n    except Exception as e:\n        return f\"【撤单失败】{str(e)}\"\n\ndef get_today_orders():\n    \"\"\"查询今日所有订单\"\"\"\n    orders = trade_cli.get_orders()\n    if not orders:\n        return \"今日无任何委托订单\"\n    text = \"【今日订单列表】\\n\"\n    for o in orders:\n        text += f\"ID:{o.id} | {o.action} {o.symbol} | 状态：{o.status} | 价格：{o.limit_price} | 数量：{o.quantity}\\n\"\n    return text\n\ndef get_open_orders():\n    \"\"\"查询未成交订单\"\"\"\n    orders = trade_cli.get_open_orders()\n    if not orders:\n        return \"当前无未成交订单\"\n    text = \"【未成交订单】\\n\"\n    for o in orders:\n        text += f\"ID:{o.id} 