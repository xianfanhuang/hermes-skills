  print(\"  ⚠️ 无数据\")\nexcept Exception as e:\n    print(f\"  ❌ {str(e)[:150]}\")\n\n# 测试3: 用实盘账户（1406653）\nprint(\"\\n[3] 生产域名 + 实盘账户:\")\nconfig3 = TigerOpenClientConfig(sandbox_debug=False)\nconfig3.tiger_id = '20159412'\nconfig3.account = '1406653'\nconfig3.private_key = private_key\nconfig3.language = Language.zh_CN\n\ntry:\n    qc3 = QuoteClient(config3)\n    res = qc3.get_briefs(['AAPL'])\n    if res:\n        q = res[0]\n        print(f\"  ✅ AAPL: ${q.latest_price:.2f} ({q.change_percent:.2f}%)\")\n    else:\n        print(\"  ⚠️ 无数据\")\nexcept Exception as e:\n    print(f\"  ❌ {str(e)[:150]}\")\nPYEOF","timeout":60}}],"api":"openai-completions","provider":"xiaomimimo","model":"mimo-v2.5-pro","usage":{"input":492,"output":1445,"cacheRead":87744,"cacheWrite":0,"totalTokens":89681,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779159096644}}
