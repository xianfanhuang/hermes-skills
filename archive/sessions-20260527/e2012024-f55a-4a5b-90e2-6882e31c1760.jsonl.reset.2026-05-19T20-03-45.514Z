{"type":"message","id":"19f8a0f4","parentId":"d457773c","timestamp":"2026-05-19T02:37:28.506Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"The SDK doesn't have `Region` or `Env` enums. It uses dynamic domain selection. Let me try a simpler approach - just set the server_url directly.","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_e5e413a1c3c6479fa30bafac","name":"exec","arguments":{"command":"python3 << 'PYEOF'\nfrom tigeropen.common.consts import Language\nfrom tigeropen.tiger_open_config import TigerOpenClientConfig\nfrom tigeropen.quote.quote_client import QuoteClient\nfrom tigeropen.trade.trade_client import TradeClient\n\nprivate_key = \"\"\n\nconfig = TigerOpenClientConfig(sandbox_debug=False)\nconfig.tiger_id = '20159412'\nconfig.account = '21409378833585169'\nconfig.private_key = private_key\nconfig.language = Language.zh_CN\n# 模拟盘域名（已验证可达）\nconfig.server_url = 'https://openapi-sandbox.tigerfintech.com/gateway'\nconfig.quote_server_url = 'https://openapi-sandbox.tigerfintech.com/gateway'\n\nprint(\"=\" * 50)\nprint(\"🐯 老虎证券 新加坡模拟盘 实时测试\")\nprint(\"=\" * 50)\n\n# 1. 账户信息\nprint(\"\\n📊 [1] 账户信息:\")\ntry:\n    trade_client = TradeClient(config)\n    assets = trade_client.get_assets()\n    if assets:\n        summary = assets[0].summary\n        print(f\"  ✅ 总资产(净值): ${summary.net_liquidation:,.2f}\")\n        print(f\"  ✅ 可用资金: ${summary.cash:,.2f}\")\n        print(f\"  ✅ 购买力: ${summary.buying_power:,.2f}\")\n    else:\n        print(\"  ❌ 未获取到账户信息\")\nexcept Exception as e:\n    print(f\"  ❌ 错误: {type(e).__name__}: {str(e)[:200]}\")\n\n# 2. 行情测试\nprint(\"\\n📈 [2] 行情测试:\")\ntry:\n    quote_client = QuoteClient(config)\n    for sym in ['AAPL', 'TSLA', 'NVDA']:\n        try:\n            res = quote_client.get_briefs([sym])\n            if res:\n                q = res[0]\n                print(f\"  ✅ {sym}: ${q.latest_price:.2f} ({q.change_percent:.2f}%)\")\n            else:\n                print(f\"  ⚠️ {sym}: 无数据\")\n        except Exception as e:\n            print(f\"  ❌ {sym}: {type(e).__name__}: {str(e)[:100]}\")\nexcept Exception as e:\n    print(f\"  ❌ 行情客户端错误: {type(e).__name__}: {str(e)[:200]}\")\n\n# 3. 持仓查询\nprint(\"\\n💼 [3] 持仓查询:\")\ntry:\n    positions = trade_client.get_positions()\n    if positions:\n        for p in positions:\n            print(f\"  📌 {p.symbol}: {p.quantity}股 | 成本: ${p.cost_price:.2f} | 盈亏: ${p.unrealized_pnl:.2f}\")\n    else:\n        print(\"  ✅ 当前无持仓（空账户）\")\nexcept Exception as e:\n    print(f\"  ❌ 错误: {type(e).__name__}: {str(e)[:200]}\")\n\n# 4. 订单查询\nprint(\"\\n📋 [4] 订单查询:\")\ntry:\n    orders = trade_client.get_orders()\n    if orders:\n        for o in orders:\n            print(f\"  📌 ID:{o.id} | {o.action} {o.symbol} | {o.status}\")\n    else:\n        print(\"  ✅ 今日无订单\")\nexcept Exception as e:\n    print(f\"  ❌ 错误: {type(e).__name__}: {str(e)[:200]}\")\n\nprint(\"\\n\" + \"=\" * 50)\nprint(\"🏁 测试完成\")\nprint(\"=\" * 50)\nPYEOF","timeout":30}}],"api":"openai-completions","provider":"xiaomimimo","model":"mimo-v2.5-pro","usage":{"input":809,"output":1523,"cacheRead":75776,"cacheWrite":0,"totalTokens":78108,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779158226293}}
