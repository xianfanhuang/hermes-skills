rice = self.portfolio.get('avg_cost', 0)\n+ 501         direction = self.portfolio.get('current_direction', 'short')\n+ 502         exit_plan = analysis.exit_plan\n+ 503 \n+ 504         if not exit_plan:\n+ 505             return None\n+ 506 \n+ 507         # ---- 1. 入场止损检查 ----\n+ 508         stop_loss = exit_plan.get('stop_loss', {})\n+ 509         if stop_loss and stop_loss.get('price'):\n+ 510             sl_price = stop_loss['price']\n+ 511             if direction == 'short' and current_price >= sl_price:\n+ 512                 return {\n+ 513                     'reason': '入场止损',\n+ 514                     'detail': stop_loss.get('reason', ''),\n+ 515                     'price': current_price,\n+ 516                     'stop_price': sl_price\n+ 517                 }\n+ 518             elif direction == 'long' and current_price <= sl_price:\n+ 519                 return {\n+ 520                     'reason': '入场止损',\n+ 521                     'detail': stop_loss.get('reason', ''),\n+ 522                     'price': current_price,\n+ 523                     'stop_price': sl_price\n+ 524                 }\n+ 525 \n+ 526         # ---- 2. 持仓止盈检查 ----\n+ 527         take_profit = exit_plan.get('take_profit', {})\n+ 528         if take_profit and take_profit.get('price'):\n+ 529             tp_price = take_profit['price']\n+ 530             if direction == 'short' and current_price <= tp_price:\n+ 531                 return {\n+ 532                     'reason': '持仓止盈',\n+ 533                     'detail': take_profit.get('reason', ''),\n+ 534                     'price': current_price,\n+ 535                     'stop_price': tp_price\n+ 536                 }\n+ 537             elif direction == 'long' and current_price >= tp_price:\n+ 538                 return {\n+ 539                     'reason': '持仓止盈',\n+ 540                     'detail': take_profit.get('reason', ''),\n+ 541                     'price': current_price,\n+ 542                     'stop_price': tp_price\n+ 543                 }\n+ 544 \n+ 545         # ---- 3. 结构止损检查（30分钟反向信号） ----\n+ 546         structural_stop = exit_plan.get('structural_stop', {})\n+ 547         if structural_stop and analysis.min30:\n+ 548             min30_bsp = analysis.min30.get('buy_sell_points', [])\n+ 549             condition = structural_stop.get('condition', '')\n+ 550 \n+ 551             if condition == '30min_buy_signal':\n+ 552                 # 做空持仓，30分钟出现买点 → 结构破坏\n+ 553                 buy_signals = [b for b in min30_bsp if 'buy' in b.get('type', '')]\n+ 554                 if buy_signals:\n+ 555                     best = max(buy_signals, key=lambda x: x.get('confidence', 0))\n+ 556                     return {\n+ 557                         'reason': '结构止损',\n+ 558                         'detail': f\"30分钟买点: {best['type']} @ {best['price']:.2f}\",\n+ 559                         'price': current_price,\n+ 560                         'stop_price': best['price']\n+ 561                     }\n+ 562             elif condition == '30min_sell_signal':\n+ 563                 # 做多持仓，30分钟出现卖点 → 结构破坏\n+ 564                 sell_signals = [b for b in min30_bsp if 'sell' in b.get('type', '')]\n+ 565                 if sell_signals:\n+ 566                     best = max(sell_signals, key=lambda x: x.get('confidence', 0))\n+ 567                     return {\n+ 568                         'reason': '结构止损',\n+ 569                         'detail': f\"30分钟卖点: {best['type']} @ {best['price']:.2f}\",\n+ 570                         'price': current_price,\n+ 571                         'stop_price': best['price']\n+ 572                     }\n+ 573 \n+ 574         # ---- 4. 移动止损检查 ----\n+ 575         trailing = exit_plan.get('trailing_stop', {})\n+ 576         if trailing and entry_price > 0:\n+ 577             trigger_pct = trailing.get('trigger_pct', 0.02)\n+ 578             if direction == 'short':\n+ 579                 profit_pct = (entry_price - current_price) / entry_price\n+ 