{"type":"message","id":"0e8b65f4","parentId":"41e4c35b","timestamp":"2026-05-26T18:58:34.417Z","message":{"role":"toolResult","toolCallId":"call_9f1db561114349298643e403","toolName":"gateway","content":[{"type":"text","text":"{\n  \"ok\": true,\n  \"result\": {\n    \"path\": \"memory.qmd\",\n    \"schema\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false\n    },\n    \"children\": [\n      {\n        \"key\": \"command\",\n        \"path\": \"memory.qmd.command\",\n        \"type\": \"string\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Binary\",\n          \"help\": \"Sets the executable path for the `qmd` binary used by the QMD backend (default: resolved from PATH). Use an explicit absolute path when multiple qmd installs exist or PATH differs across environments.\",\n          \"tags\": [\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.command\"\n      },\n      {\n        \"key\": \"mcporter\",\n        \"path\": \"memory.qmd.mcporter\",\n        \"type\": \"object\",\n        \"required\": false,\n        \"hasChildren\": true,\n        \"hint\": {\n          \"label\": \"QMD MCPorter\",\n          \"help\": \"Routes QMD work through mcporter (MCP runtime) instead of spawning `qmd` for each call. Use this when cold starts are expensive on large models; keep direct process mode for simpler local setups.\",\n          \"tags\": [\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.mcporter\"\n      },\n      {\n        \"key\": \"searchMode\",\n        \"path\": \"memory.qmd.searchMode\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Search Mode\",\n          \"help\": \"Selects the QMD retrieval path: \\\"query\\\" uses standard query flow, \\\"search\\\" uses search-oriented retrieval, and \\\"vsearch\\\" emphasizes vector retrieval. Keep default unless tuning relevance quality.\",\n          \"tags\": [\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.searchMode\"\n      },\n      {\n        \"key\": \"includeDefaultMemory\",\n        \"path\": \"memory.qmd.includeDefaultMemory\",\n        \"type\": \"boolean\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Include Default Memory\",\n          \"help\": \"Automatically indexes default memory files (MEMORY.md and memory/**/*.md) into QMD collections. Keep enabled unless you want indexing controlled only through explicit custom paths.\",\n          \"tags\": [\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.includeDefaultMemory\"\n      },\n      {\n        \"key\": \"paths\",\n        \"path\": \"memory.qmd.paths\",\n        \"type\": \"array\",\n        \"required\": false,\n        \"hasChildren\": true,\n        \"hint\": {\n          \"label\": \"QMD Extra Paths\",\n          \"help\": \"Adds custom directories or files to include in QMD indexing, each with an optional name and glob pattern. Use this for project-specific knowledge locations that are outside default memory paths.\",\n          \"tags\": [\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.paths\"\n      },\n      {\n        \"key\": \"sessions\",\n        \"path\": \"memory.qmd.sessions\",\n        \"type\": \"object\",\n        \"required\": false,\n        \"hasChildren\": true\n      },\n      {\n        \"key\": \"update\",\n        \"path\": \"memory.qmd.update\",\n        \"type\": \"object\",\n        \"required\": false,\n        \"hasChildren\": true\n      },\n      {\n        \"key\": \"limits\",\n        \"path\": \"memory.qmd.limits\",\n        \"type\": \"object\",\n        \"required\": false,\n        \"hasChildren\": true\n      },\n      {\n        \"key\": \"scope\",\n        \"path\": \"memory.qmd.scope\",\n        \"type\": \"object\",\n        \"required\": false,\n        \"hasChildren\": true,\n        \"hint\": {\n          \"label\": \"QMD Surface Scope\",\n          \"help\": \"Defines which sessions/channels are eligible for QMD recall using session.sendPolicy-style rules. Keep default direct-only scope unless you intentionally want cross-chat memory sharing.\",\n          \"tags\": [\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.scope\"\n      }\n    ]\n  }\n}"}],"details":{"ok":true,"result":{"path":"memory.qmd","schema":{"type":"object","additionalProperties":false},"children":[{"key":"command","path":"memory.qmd.command","type":"string","required":false,"hasChildren":false,"hint":{"label":"QMD Binary","help":"Sets the executable path for the `qmd` binary used by the QMD backend (default: resolved from PATH). Use an explicit absolute path when multiple qmd installs exist or PATH differs across environments.","tags":["storage"]},"hintPath":"memory.qmd.command"},{"key":"mcporter","path":"memory.qmd.mcporter","type":"object","required":false,"hasChildren":true,"hint":{"label":"QMD MCPorter","help":"Routes QMD work through mcporter (MCP runtime) instead of spawning `qmd` for each call. Use this when cold starts are expensive on large models; keep direct process mode for simpler local setups.","tags":["storage"]},"hintPath":"memory.qmd.mcporter"},{"key":"searchMode","path":"memory.qmd.searchMode","required":false,"hasChildren":false,"hint":{"label":"QMD Search Mode","help":"Selects the QMD retrieval path: \"query\" uses standard query flow, \"search\" uses search-oriented retrieval, and \"vsearch\" emphasizes vector retrieval. Keep default unless tuning relevance quality.","tags":["storage"]},"hintPath":"memory.qmd.searchMode"},{"key":"includeDefaultMemory","path":"memory.qmd.includeDefaultMemory","type":"boolean","required":false,"hasChildren":false,"hint":{"label":"QMD Include Default Memory","help":"Automatically indexes default memory files (MEMORY.md and memory/**/*.md) into QMD collections. Keep enabled unless you want indexing controlled only through explicit custom paths.","tags":["storage"]},"hintPath":"memory.qmd.includeDefaultMemory"},{"key":"paths","path":"memory.qmd.paths","type":"array","required":false,"hasChildren":true,"hint":{"label":"QMD Extra Paths","help":"Adds custom directories or files to include in QMD indexing, each with an optional name and glob pattern. Use this for project-specific knowledge locations that are outside default memory paths.","tags":["storage"]},"hintPath":"memory.qmd.paths"},{"key":"sessions","path":"memory.qmd.sessions","type":"object","required":false,"hasChildren":true},{"key":"update","path":"memory.qmd.update","type":"object","required":false,"hasChildren":true},{"key":"limits","path":"memory.qmd.limits","type":"object","required":false,"hasChildren":true},{"key":"scope","path":"memory.qmd.scope","type":"object","required":false,"hasChildren":true,"hint":{"label":"QMD Surface Scope","help":"Defines which sessions/channels are eligible for QMD recall using session.sendPolicy-style rules. Keep default direct-only scope unless you intentionally want cross-chat memory sharing.","tags":["storage"]},"hintPath":"memory.qmd.scope"}]}},"isError":false,"timestamp":1779821914415}}
