r defaults. Use this for proxy auth and tenant routing headers, and keep values minimal to avoid leaking sensitive metadata.","tags":["advanced"]},"hintPath":"agents.defaults.memorySearch.remote.headers"},{"key":"batch","path":"agents.defaults.memorySearch.remote.batch","type":"object","required":false,"hasChildren":true}]}},"isError":false,"timestamp":1779823292973}}
