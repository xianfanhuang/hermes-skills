ort XiaomiPaperTrader\nfrom czsc_extension import CzscExtension\nfrom czsc import CZSC, Freq, format_standard_kline\nfrom datetime import datetime\nimport pandas as pd\nt = XiaomiPaperTrader()\n\nbars = t.quote_client.get_bars(['01810'], period='day', begin_time='2026-01-01', end_time='2026-05-26')\nbars['dt'] = bars['time'].apply(lambda x: datetime.fromtimestamp(x/1000))\nbars['symbol'] = '01810'\nbars['vol'] = bars['volume']\nbars['amount'] = bars.get('amount', bars['vol'] * bars['close'])\n\nformatted = format_standard_kline(bars, freq=Freq.D)\nczsc_obj = CZSC(formatted)\n\nprint('=== 手动买卖点分析 ===')\nbis = czsc_obj.bi_list\n\n# 找所有向下笔的低点（潜在买点）\nprint('\\\\n向下笔（潜在买点）:')\nfor i, bi in enumerate(bis):\n    if bi.direction.value == 'down':\n        print(f'  [{i}] ↓ {bi.high:.2f}→{bi.low:.2f} ({bi.sdt.strftime(\\\"%m-%d\\\")}~{bi.edt.strftime(\\\"%m-%d\\\")}) power={bi.power:.2f}')\n\n# 找所有向上笔的高点（潜在卖点）\nprint('\\\\n向上笔（潜在卖点）:')\nfor i, bi in enumerate(bis):\n    if bi.direction.value == 'up':\n        print(f'  [{i}] ↑ {bi.low:.2f}→{bi.high:.2f} ({bi.sdt.strftime(\\\"%m-%d\\\")}~{bi.edt.strftime(\\\"%m-%d\\\")}) power={bi.power:.2f}')\n\n# 背驰分析：对比最后两个同向笔\nprint('\\\\n=== 底背驰分析（最后两个向下笔）===')\ndown_bis = [(i, bi) for i, bi in enumerate(bis) if bi.direction.value == 'down']\nif len(down_bis) >= 2:\n    _, prev = down_bis[-2]\n    _, last = down_bis[-1]\n    print(f'  前一下跌笔: {prev.high:.2f}→{prev.low:.2f} power={prev.power:.2f} ({prev.sdt.strftime(\\\"%m-%d\\\")}~{prev.edt.strftime(\\\"%m-%d\\\")})')\n    print(f'  后一下跌笔: {last.high:.2f}→{last.low:.2f} power={last.power:.2f} ({last.sdt.strftime(\\\"%m-%d\\\")}~{last.edt.strftime(\\\"%m-%d\\\")})')\n    print(f'  新低: {last.low < prev.low}')\n    print(f'  力度比: {last.power/prev.power:.2f}')\n    if last.low < prev.low and last.power < prev.power:\n        print(f'  ⚠️ 底背驰! 新低{last.low:.2f}<{prev.low:.2f}, 力度减弱{last.power:.2f}<{prev.power:.2f}')\n    elif last.low < prev.low:\n        print(f'  新低但力度未减弱，无背驰')\n    else:\n        print(f'  未创新低')\n\n# 当前位置分析\nprint('\\\\n=== 当前位置分析 ===')\nlast_bi = bis[-1]\nprint(f'最后笔: [{last_bi.direction.value}] {last_bi.fx_a.fx:.2f}→{last_bi.fx_b.fx:.2f} ({last_bi.edt.strftime(\\\"%m-%d\\\")})')\nprint(f'当前价: \\$30.16')\nprint(f'最后笔结束于: {last_bi.edt.strftime(\\\"%Y-%m-%d\\\")}')\nprint(f'最后笔类型: {\\\"向上\\\" if last_bi.direction.value == \\\"up\\\" else \\\"向下\\\"}')\n\n# 分析当前在哪个买卖点之后\nif last_bi.direction.value == 'up':\n    # 最后一笔向上 → 当前在某个买点之后\n    # 找这个向上笔的起点（就是买点）\n    buy_price = last_bi.fx_a.fx\n    buy_date = last_bi.sdt\n    print(f'\\\\n📍 当前在买点之后:')\n    print(f'   买点位置: \\${buy_price:.2f} ({buy_date.strftime(\\\"%m-%d\\\")})')\n    print(f'   买点类型: 需要判断是几买')\n    print(f'   当前价格: \\$30.16 (从买点上涨{(30.16-buy_price)/buy_price*100:.1f}%)')\nelse:\n    # 最后一笔向下 → 当前在某个卖点之后\n    sell_price = last_bi.fx_a.fx\n    sell_date = last_bi.sdt\n    print(f'\\\\n📍 当前在卖点之后:')\n    print(f'   卖点位置: \\${sell_price:.2f} ({sell_date.strftime(\\\"%m-%d\\\")})')\n    print(f'   当前价格: \\$30.16 (从卖点下跌{(sell_price-30.16)/sell_price*100:.1f}%)')\n\" 2>&1 | grep -v \"sdk version\" | grep -v \"Grab quote\" | grep -v \"小米模拟\" | grep -v \"当前持仓\" | grep -v \"累计盈亏\" | grep -v \"^\\[\" | grep -v \"^$\"","timeout":30}}],"api":"openai-completions","provider":"xiaomimimo","model":"mimo-v2.5-pro","usage":{"input":1227,"output":2448,"cacheRead":99264,"cacheWrite":0,"totalTokens":102939,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779769160425}}
