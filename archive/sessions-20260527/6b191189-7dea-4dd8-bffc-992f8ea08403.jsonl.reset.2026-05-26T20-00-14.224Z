'trailing_stop'] = 'profit_3pct_move_to_entry'\n+ 422             # ---- 做多出场 ----\n+ 423             # 入场止损 = 买点被否定（价格跌破中枢下沿）\n+ 424             plan['stop_loss'] = {\n+ 425                 'price': zs_zd,\n+ 426                 'type': 'entry_invalidation',\n+ 427                 'reason': f'买点被否定: 价格跌破{zs_zd:.2f}'\n+ 428             }\n+ 429             # 持仓止盈 = 上升趋势结束（价格回到中枢上沿）\n+ 430             plan['take_profit'] = {\n+ 431                 'price': zs_zg,\n+ 432                 'type': 'holding_invalidation',\n+ 433                 'reason': f'上升趋势结束: 价格回到{zs_zg:.2f}'\n+ 434             }\n+ 435             # 移动止损 = 盈利2%后止损移到入场价\n+ 436             plan['trailing_stop'] = {\n+ 437                 'trigger_pct': 0.02,\n+ 438                 'action': 'move_to_entry',\n+ 439                 'reason': '盈利2%后保护利润'\n+ 440             }\n+ 441             # 结构止损 = 30分钟出现卖点\n+ 442             plan['structural_stop'] = {\n+ 443                 'condition': '30min_sell_signal',\n+ 444                 'reason': '小级别结构破坏'\n+ 445             }\n  422             plan['exit_conditions'] = [\n- 423                 f\"止损: 价格跌破 {plan['stop_loss']:.2f} (入场逻辑破坏: 买点被否定)\",\n- 424                 f\"止盈: 价格回到 {plan['take_profit']:.2f} (持仓逻辑破坏: 上升趋势结束)\",\n- 425                 \"移动止损: 盈利3%后止损移到入场价\",\n- 426                 \"结构止损: 30分钟出现反向卖点\"\n+ 447                 f\"入场止损: 价格跌破 {zs_zd:.2f} (买点被否定)\",\n+ 448                 f\"持仓止盈: 价格回到 {zs_zg:.2f} (上升趋势结束)\",\n+ 449                 \"移动止损: 盈利2%后止损移到入场价\",\n+ 450                 \"结构止损: 30分钟出现卖点\"\n  427             ]\n+ 452 \n  428         else:\n- 429             # 做空止损 = 入场逻辑破坏：价格突破shock_sell价格\n- 430             plan['stop_loss'] = zs_zg  # 中枢上沿 = 入场逻辑破坏点\n- 431             # 做空止盈 = 持仓逻辑破坏：价格回到前低以上\n- 432             plan['take_profit'] = zs_zd  # 中枢下沿 = 持仓逻辑破坏点\n- 433             plan['trailing_stop'] = 'profit_3pct_move_to_entry'\n+ 454             # ---- 做空出场 ----\n+ 455             # 入场止损 = 卖点被否定（价格突破中枢上沿）\n+ 456        