(line.split('：')[1].strip())\n                        except:\n                            pass\n                \n                if price > 0:\n                    return Quote(\n                        symbol=symbol,\n                        price=price,\n                        change=change,\n                        change_pct=change_pct,\n                        high=high,\n                        low=low,\n                        open=open_price,\n                        prev_close=prev_close,\n                        timestamp=datetime.now().isoformat()\n                    )\n        except Exception as e:\n            logger.error(f\"Tiger行情获取失败 {symbol}: {e}\")\n        return None","old_string":"    @staticmethod\n    def get_tiger_quote(symbol: str) -> Optional[Quote]:\n        \"\"\"从Tiger获取港股实时行情\"\"\"\n        try:\n            from tiger_client import get_stock_brief\n            result = get_stock_brief(symbol)\n            # 解析Tiger返回的数据\n            if result and 'price' in result:\n                return Quote(\n                    symbol=symbol,\n                    price=result.get('price', 0),\n                    change=result.get('change', 0),\n                    change_pct=result.get('change_pct', 0),\n                    high=result.get('high', 0),\n                    low=result.get('low', 0),\n                    open=result.get('open', 0),\n                    prev_close=result.get('prev_close', 0),\n                    timestamp=datetime.now().isoformat()\n                )\n        except Exception as e:\n            logger.error(f\"Tiger行情获取失败 {symbol}: {e}\")\n        return None"}}],"api":"openai-completions","provider":"xiaomimimo","model":"mimo-v2.5-pro","usage":{"input":363,"output":661,"cacheRead":107712,"cacheWrite":0,"totalTokens":108736,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779806078401}}
