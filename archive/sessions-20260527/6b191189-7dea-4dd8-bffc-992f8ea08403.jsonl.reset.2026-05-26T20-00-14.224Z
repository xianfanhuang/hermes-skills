{"type":"message","id":"e4a6d3ca","parentId":"71e322a4","timestamp":"2026-05-26T18:58:45.221Z","message":{"role":"toolResult","toolCallId":"call_038e4a31349e4141a04f978a","toolName":"gateway","content":[{"type":"text","text":"{\n  \"ok\": true,\n  \"result\": {\n    \"path\": \"memory.qmd.update\",\n    \"schema\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false\n    },\n    \"children\": [\n      {\n        \"key\": \"interval\",\n        \"path\": \"memory.qmd.update.interval\",\n        \"type\": \"string\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Update Interval\",\n          \"help\": \"Sets how often QMD refreshes indexes from source content (duration string, default: 5m). Shorter intervals improve freshness but increase background CPU and I/O.\",\n          \"tags\": [\n            \"performance\",\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.update.interval\"\n      },\n      {\n        \"key\": \"debounceMs\",\n        \"path\": \"memory.qmd.update.debounceMs\",\n        \"type\": \"integer\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Update Debounce (ms)\",\n          \"help\": \"Sets the minimum delay between consecutive QMD refresh attempts in milliseconds (default: 15000). Increase this if frequent file changes cause update thrash or unnecessary background load.\",\n          \"tags\": [\n            \"performance\",\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.update.debounceMs\"\n      },\n      {\n        \"key\": \"onBoot\",\n        \"path\": \"memory.qmd.update.onBoot\",\n        \"type\": \"boolean\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Update on Startup\",\n          \"help\": \"Runs an initial QMD update once during gateway startup (default: true). Keep enabled so recall starts from a fresh baseline; disable only when startup speed is more important than immediate freshness.\",\n          \"tags\": [\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.update.onBoot\"\n      },\n      {\n        \"key\": \"waitForBootSync\",\n        \"path\": \"memory.qmd.update.waitForBootSync\",\n        \"type\": \"boolean\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Wait for Boot Sync\",\n          \"help\": \"Blocks startup completion until the initial boot-time QMD sync finishes (default: false). Enable when you need fully up-to-date recall before serving traffic, and keep off for faster boot.\",\n          \"tags\": [\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.update.waitForBootSync\"\n      },\n      {\n        \"key\": \"embedInterval\",\n        \"path\": \"memory.qmd.update.embedInterval\",\n        \"type\": \"string\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Embed Interval\",\n          \"help\": \"Sets how often QMD recomputes embeddings (duration string, default: 60m; set 0 to disable periodic embeds). Lower intervals improve freshness but increase embedding workload and cost.\",\n          \"tags\": [\n            \"performance\",\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.update.embedInterval\"\n      },\n      {\n        \"key\": \"commandTimeoutMs\",\n        \"path\": \"memory.qmd.update.commandTimeoutMs\",\n        \"type\": \"integer\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Command Timeout (ms)\",\n          \"help\": \"Sets timeout for QMD maintenance commands such as collection list/add in milliseconds (default: 30000). Increase when running on slower disks or remote filesystems that delay command completion.\",\n          \"tags\": [\n            \"performance\",\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.update.commandTimeoutMs\"\n      },\n      {\n        \"key\": \"updateTimeoutMs\",\n        \"path\": \"memory.qmd.update.updateTimeoutMs\",\n        \"type\": \"integer\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Update Timeout (ms)\",\n          \"help\": \"Sets maximum runtime for each `qmd update` cycle in milliseconds (default: 120000). Raise this for larger collections; lower it when you want quicker failure detection in automation.\",\n          \"tags\": [\n            \"performance\",\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.update.updateTimeoutMs\"\n      },\n      {\n        \"key\": \"embedTimeoutMs\",\n        \"path\": \"memory.qmd.update.embedTimeoutMs\",\n        \"type\": \"integer\",\n        \"required\": false,\n        \"hasChildren\": false,\n        \"hint\": {\n          \"label\": \"QMD Embed Timeout (ms)\",\n          \"help\": \"Sets maximum runtime for each `qmd embed` cycle in milliseconds (default: 120000). Increase for heavier embedding workloads or slower hardware, and lower to fail fast under tight SLAs.\",\n          \"tags\": [\n            \"performance\",\n            \"storage\"\n          ]\n        },\n        \"hintPath\": \"memory.qmd.update.embedTimeoutMs\"\n      }\n    ]\n  }\n}"}],"details":{"ok":true,"result":{"path":"memory.qmd.update","schema":{"type":"object","additionalProperties":false},"children":[{"key":"interval","path":"memory.qmd.update.interval","type":"string","required":false,"hasChildren":false,"hint":{"label":"QMD Update Interval","help":"Sets how often QMD refreshes indexes from source content (duration string, default: 5m). Shorter intervals improve freshness but increase background CPU and I/O.","tags":["performance","storage"]},"hintPath":"memory.qmd.update.interval"},{"key":"debounceMs","path":"memory.qmd.update.debounceMs","type":"integer","required":false,"hasChildren":false,"hint":{"label":"QMD Update Debounce (ms)","help":"Sets the minimum delay between consecutive QMD refresh attempts in milliseconds (default: 15000). Increase this if frequent file changes cause update thrash or unnecessary background load.","tags":["performance","storage"]},"hintPath":"memory.qmd.update.debounceMs"},{"key":"onBoot","path":"memory.qmd.update.onBoot","type":"boolean","required":false,"hasChildren":false,"hint":{"label":"QMD Update on Startup","help":"Runs an initial QMD update once during gateway startup (default: true). Keep enabled so recall starts from a fresh baseline; disable only when startup speed is more important than immediate freshness.","tags":["storage"]},"hintPath":"memory.qmd.update.onBoot"},{"key":"waitForBootSync","path":"memory.qmd.update.waitForBootSync","type":"boolean","required":false,"hasChildren":false,"hint":{"label":"QMD Wait for Boot Sync","help":"Blocks startup completion until the initial boot-time QMD sync finishes (default: false). Enable when you need fully up-to-date recall before serving traffic, and keep off for faster boot.","tags":["storage"]},"hintPath":"memory.qmd.update.waitForBootSync"},{"key":"embedInterval","path":"memory.qmd.update.embedInterval","type":"string","required":false,"hasChildren":false,"hint":{"label":"QMD Embed Interval","help":"Sets how often QMD recomputes embeddings (duration string, default: 60m; set 0 to disable periodic embeds). Lower intervals improve freshness but increase embedding workload and cost.","tags":["performance","storage"]},"hintPath":"memory.qmd.update.embedInterval"},{"key":"commandTimeoutMs","path":"memory.qmd.update.commandTimeoutMs","type":"integer","required":false,"hasChildren":false,"hint":{"label":"QMD Command Timeout (ms)","help":"Sets timeout for QMD maintenance commands such as collection list/add in milliseconds (default: 30000). Increase when running on slower disks or remote filesystems that delay command completion.","tags":["performance","storage"]},"hintPath":"memory.qmd.update.commandTimeoutMs"},{"key":"updateTimeoutMs","path":"memory.qmd.update.updateTimeoutMs","type":"integer","required":false,"hasChildren":false,"hint":{"label":"QMD Update Timeout (ms)","help":"Sets maximum runtime for each `qmd update` cycle in milliseconds (default: 120000). Raise this for larger collections; lower it when you want quicker failure detection in automation.","tags":["performance","storage"]},"hintPath":"memory.qmd.update.updateTimeoutMs"},{"key":"embedTimeoutMs","path":"memory.qmd.update.embedTimeoutMs","type":"integer","required":false,"hasChildren":false,"hint":{"label":"QMD Embed Timeout (ms)","help":"Sets maximum runtime for each `qmd embed` cycle in milliseconds (default: 120000). Increase for heavier embedding workloads or slower hardware, and lower to fail fast under tight SLAs.","tags":["performance","storage"]},"hintPath":"memory.qmd.update.embedTimeoutMs"}]}},"isError":false,"timestamp":1779821925220}}
