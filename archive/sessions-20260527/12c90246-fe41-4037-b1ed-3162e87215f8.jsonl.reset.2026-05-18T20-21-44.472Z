rent / \"data\" / \"finance_fetcher\"))\nsys.path.insert(0, str(Path(__file__).parent / \"data\" / \"finance_perception\" / \"scripts\"))\n\n# CZSC 导入\nimport czsc\nfrom czsc import CZSC, BarGenerator, Freq, format_standard_kline\nfrom czsc.utils.bar_generator import freq_end_time","path":"/workspace/projects/workspace/chanlun-agent/chanlun_perception.py"}}],"api":"openai-completions","provider":"xiaomimimo","model":"mimo-v2.5-pro","usage":{"input":502,"output":819,"cacheRead":83200,"cacheWrite":0,"totalTokens":84521,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779108944336}}
