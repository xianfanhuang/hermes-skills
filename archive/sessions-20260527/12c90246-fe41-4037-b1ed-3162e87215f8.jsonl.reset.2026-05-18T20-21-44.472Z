ng\",\n      \"priority\": 2,\n      \"aligned_goals\": [\n        \"financial_perception\"\n      ],\n      \"quality_metrics\": {\n        \"success_rate\": 0.0,\n        \"avg_response_time_ms\": 0,\n        \"signal_count_7d\": 0,\n        \"actionable_ratio\": 0.0\n      },\n      \"last_fetch\": null,\n      \"last_evaluated\": \"2026-05-18\",\n      \"failure_history\": [],\n      \"notes\": \"待配置API Key，完全免费，1000次/天，覆盖美国宏观指标\",\n      \"api_config\": {\n        \"base_url\": \"https://api.stlouisfed.org/fred\",\n        \"requires_key\": true,\n        \"rate_limit\": {\n          \"requests_per_day\": 1000\n        },\n        \"popular_series\": [\"GDP\", \"CPI\", \"UNRATE\", \"FEDFUNDS\", \"DGS10\"]\n      },\n      \"fetch_history\": []\n    },\n    \"polygon\": {\n      \"name\": \"Polygon.io 美股/外汇/加密\",\n      \"type\": \"finance\",\n      \"status\": \"active\",\n      \"priority\": 1,\n      \"aligned_goals\": [\n        \"financial_perception\"\n      ],\n      \"quality_metrics\": {\n        \"success_rate\": 1.0,\n        \"avg_response_time_ms\": 300,\n        \"signal_count_7d\": 0,\n        \"actionable_ratio\": 0.3\n      },\n      \"last_fetch\": null,\n      \"last_evaluated\": \"2026-05-18\",\n      \"failure_history\": [],\n      \"notes\": \"Polygon.io 免费版：5次/分钟，支持美股/外汇/加密/期权延迟行情，V2 API优先\",\n      \"api_config\": {\n        \"base_url\": \"https://api.polygon.io\",\n        \"supports_markets\": [\"US\", \"GB\", \"CC\"],\n        \"supports_kline\": true,\n        \"supports_forex\": true,\n        \"supports_crypto\": true,\n        \"rate_limit\": {\n          \"requests_per_minute\": 5\n        }\n      },\n      \"fetch_history\": []\n    }\n  },\n  \"goal_source_mapping\": {\n    \"security\": {\n      \"primary\": [\n        \"nvd\"\n      ],\n      \"secondary\": [\n        \"threatpost\",\n        \"dark_reading\"\n      ]\n    },\n    \"self_evolution\": {\n      \"primary\": [\n        \"arxiv\",\n        \"hackernews\",\n     