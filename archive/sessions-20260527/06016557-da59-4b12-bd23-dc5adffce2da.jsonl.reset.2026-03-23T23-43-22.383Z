rade\": true,\n    \"pause_reason\": null\n  },\n  \"target_metrics\": {\n    \"target_win_rate\": 70,\n    \"target_profit_per_trade_pct\": 50,\n    \"target_weekly_return_pct\": 61,\n    \"target_max_consecutive_losses\": 2\n  }\n}\n","file_path":"/workspace/projects/workspace/strategies/options_account.json"}}],"api":"openai-completions","provider":"coze","model":"auto","usage":{"input":2172,"output":677,"cacheRead":87808,"cacheWrite":0,"totalTokens":90657,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1774285707784}}
