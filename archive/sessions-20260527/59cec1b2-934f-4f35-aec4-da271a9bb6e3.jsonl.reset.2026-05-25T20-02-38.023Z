{"type":"message","id":"2541785b","parentId":"c8e9e569","timestamp":"2026-05-25T19:43:30.334Z","message":{"role":"toolResult","toolCallId":"call_6a49807feee641bf8d452976","toolName":"exec","content":[{"type":"text","text":"name: Team Notice Notification\n\non:\n  push:\n    branches:\n      - main\n    paths:\n      - 'meta-sensory/**'\n      - 'skills-豆包/**'\n\njobs:\n  notify:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 2\n\n      - name: Get commit info\n        id: commit\n        run: |\n          echo \"msg=$(git log -1 --pretty=format:'%s')\" >> $GITHUB_OUTPUT\n          echo \"author=$(git log -1 --pretty=format:'%an')\" >> $GITHUB_OUTPUT\n          echo \"sha=$(git log -1 --pretty=format:'%h')\" >> $GITHUB_OUTPUT\n\n      - name: Get Feishu Token\n        id: feishu-token\n        env:\n          FEISHU_APP_ID: ${{ secrets.FEISHU_APP_ID }}\n          FEISHU_APP_SECRET: ${{ secrets.FEISHU_APP_SECRET }}\n        run: |\n          TOKEN=$(curl -s -X POST \\\n            \"https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal\" \\\n            -H \"Content-Type: application/json\" \\\n            -d \"{\\\"app_id\\\":\\\"${FEISHU_APP_ID}\\\",\\\"app_secret\\\":\\\"${FEISHU_APP_SECRET}\\\"}\" | \\\n            python3 -c \"import sys, json; d=json.load(sys.stdin); print(d.get('tenant_access_token', ''))\")\n          echo \"token=$TOKEN\" >> $GITHUB_OUTPUT\n\n      - name: Send Feishu Message\n        env:\n          FEISHU_TOKEN: ${{ steps.feishu-token.outputs.token }}\n          CHAT_ID: \"oc_33d478474b841e1f25250090ab3e3835\"\n          COMMIT_SHA: ${{ steps.commit.outputs.sha }}\n          COMMIT_AUTHOR: ${{ steps.commit.outputs.author }}\n          COMMIT_MSG: ${{ steps.commit.outputs.msg }}\n        run: |\n          python3 << 'PYEOF'\n          import json\n          import os\n          import urllib.request\n          \n          token = os.environ['FEISHU_TOKEN']\n          chat_id = os.environ['CHAT_ID']\n          commit_sha = os.environ['COMMIT_SHA']\n          commit_author = os.environ['COMMIT_AUTHOR']\n          commit_msg = os.environ['COMMIT_MSG']\n          \n          text = f\"\"\"【团队知悉】GitHub推送通知\n\n提交: {commit_sha}\n作者: {commit_author}\n说明: {commit_msg}\n\n请回复: 已阅知悉并内化\"\"\"\n          \n          payload = {\n              \"receive_id\": chat_id,\n              \"msg_type\": \"text\",\n              \"content\": json.dumps({\"text\": text})\n          }\n          \n          req = urllib.request.Request(\n              \"https://open.feishu.cn/open-apis/im/v1/messages?receive_id_type=chat_id\",\n              data=json.dumps(payload).encode(),\n              headers={\n                  \"Authorization\": f\"Bearer {token}\",\n                  \"Content-Type\": \"application/json\"\n              },\n              method=\"POST\"\n          )\n          \n          with urllib.request.urlopen(req) as resp:\n              print(resp.read().decode())\nPYEOF"}],"details":{"status":"completed","exitCode":0,"durationMs":624,"aggregated":"name: Team Notice Notification\n\non:\n  push:\n    branches:\n      - main\n    paths:\n      - 'meta-sensory/**'\n      - 'skills-豆包/**'\n\njobs:\n  notify:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 2\n\n      - name: Get commit info\n        id: commit\n        run: |\n          echo \"msg=$(git log -1 --pretty=format:'%s')\" >> $GITHUB_OUTPUT\n          echo \"author=$(git log -1 --pretty=format:'%an')\" >> $GITHUB_OUTPUT\n          echo \"sha=$(git log -1 --pretty=format:'%h')\" >> $GITHUB_OUTPUT\n\n      - name: Get Feishu Token\n        id: feishu-token\n        env:\n          FEISHU_APP_ID: ${{ secrets.FEISHU_APP_ID }}\n          FEISHU_APP_SECRET: ${{ secrets.FEISHU_APP_SECRET }}\n        run: |\n          TOKEN=$(curl -s -X POST \\\n            \"https://open.feishu.cn/open-apis/auth/v3/tenant_access_token/internal\" \\\n            -H \"Content-Type: application/json\" \\\n            -d \"{\\\"app_id\\\":\\\"${FEISHU_APP_ID}\\\",\\\"app_secret\\\":\\\"${FEISHU_APP_SECRET}\\\"}\" | \\\n            python3 -c \"import sys, json; d=json.load(sys.stdin); print(d.get('tenant_access_token', ''))\")\n          echo \"token=$TOKEN\" >> $GITHUB_OUTPUT\n\n      - name: Send Feishu Message\n        env:\n          FEISHU_TOKEN: ${{ steps.feishu-token.outputs.token }}\n          CHAT_ID: \"oc_33d478474b841e1f25250090ab3e3835\"\n          COMMIT_SHA: ${{ steps.commit.outputs.sha }}\n          COMMIT_AUTHOR: ${{ steps.commit.outputs.author }}\n          COMMIT_MSG: ${{ steps.commit.outputs.msg }}\n        run: |\n          python3 << 'PYEOF'\n          import json\n          import os\n          import urllib.request\n          \n          token = os.environ['FEISHU_TOKEN']\n          chat_id = os.environ['CHAT_ID']\n          commit_sha = os.environ['COMMIT_SHA']\n          commit_author = os.environ['COMMIT_AUTHOR']\n          commit_msg = os.environ['COMMIT_MSG']\n          \n          text = f\"\"\"【团队知悉】GitHub推送通知\n\n提交: {commit_sha}\n作者: {commit_author}\n说明: {commit_msg}\n\n请回复: 已阅知悉并内化\"\"\"\n          \n          payload = {\n              \"receive_id\": chat_id,\n              \"msg_type\": \"text\",\n              \"content\": json.dumps({\"text\": text})\n          }\n          \n          req = urllib.request.Request(\n              \"https://open.feishu.cn/open-apis/im/v1/messages?receive_id_type=chat_id\",\n              data=json.dumps(payload).encode(),\n              headers={\n                  \"Authorization\": f\"Bearer {token}\",\n                  \"Content-Type\": \"application/json\"\n              },\n              method=\"POST\"\n          )\n          \n          with urllib.request.urlopen(req) as resp:\n              print(resp.read().decode())\nPYEOF","cwd":"/workspace/projects/workspace"},"isError":false,"timestamp":1779738210332}}
