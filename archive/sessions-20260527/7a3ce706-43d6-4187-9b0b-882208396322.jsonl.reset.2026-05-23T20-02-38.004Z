th.join(raw_dir, c)) as f:\n            chunk = json.load(f)\n        print(f\"     📦 {c} ({chunk['message_count']}条, 原因: {chunk.get('flush_reason','')})\")\n\n# 4. 结束 + 恢复\nprint(\"\\n🔄 4. 结束 + 恢复\")\nmgr.end(sid, \"闭环测试v2完成\", [\"闭环\"])\nresult = mgr.resume(5)\nprint(f\"   恢复消息数: {result.get('message_count', 0)}\")\n\nprint(\"\\n\" + \"=\" * 50)\nprint(\"  ✅ 闭环验证完成\")\nprint(\"=\" * 50)\nPYEOF","timeout":30}}],"api":"openai-completions","provider":"xiaomimimo","model":"mimo-v2.5-pro","usage":{"input":1202,"output":726,"cacheRead":113152,"cacheWrite":0,"totalTokens":115080,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779492587498}}
