{"type":"message","id":"280ebd6d","parentId":"78213b0c","timestamp":"2026-05-22T22:06:29.577Z","message":{"role":"toolResult","toolCallId":"call_f5196904371a43eb929733e7","toolName":"exec","content":[{"type":"text","text":"#!/bin/bash\n# session-archive.sh - Session 归档脚本\n# 用途: 将当前/最近的 session 对话归档到 memory/sessions/\n# 调用方式: 手动或 heartbeat 中自动执行\n\nset -euo pipefail\n\nWORKSPACE_DIR=\"/workspace/projects/workspace\"\nMEMORY_DIR=\"${WORKSPACE_DIR}/memory\"\nSESSIONS_DIR=\"${MEMORY_DIR}/sessions\"\nTODAY=$(date +%Y-%m-%d)\nNOW=$(date +%Y%m%d_%H%M%S)\n\nmkdir -p \"${SESSIONS_DIR}\"\n\n# 归档函数\narchive_session() {\n    local channel=\"$1\"\n    local session_id=\"$2\"\n    local summary=\"$3\"\n    local decisions=\"$4\"\n    local todos=\"$5\"\n\n    local archive_file=\"${SESSIONS_DIR}/${TODAY}-${channel}-${session_id}.md\"\n\n    cat > \"${archive_file}\" << EOF\n# Session 归档\n\n- **渠道**: ${channel}\n- **Session ID**: ${session_id}\n- **归档时间**: $(date '+%Y-%m-%d %H:%M:%S %z')\n\n## 对话摘要\n${summary}\n\n## 重要决策\n${decisions}\n\n## 待办事项\n${todos}\n\n---\n*自动归档 by session-archive.sh*\nEOF\n\n    echo \"[archive] 已归档: ${archive_file}\"\n}\n\n# 清理旧归档（保留30天以上的摘要）\ncleanup_old_archives() {\n    local cutoff_date=$(date -d \"30 days ago\" +%Y-%m-%d 2>/dev/null || date -v-30d +%Y-%m-%d 2>/dev/null)\n\n    if [ -z \"${cutoff_date}\" ]; then\n        echo \"[archive] 无法计算截止日期，跳过清理\"\n        return\n    fi\n\n    local count=0\n    for f in \"${SESSIONS_DIR}\"/*.md; do\n        [ -f \"$f\" ] || continue\n        local file_date=$(basename \"$f\" | grep -oP '^\\d{4}-\\d{2}-\\d{2}' || true)\n        if [ -n \"${file_date}\" ] && [[ \"${file_date}\" < \"${cutoff_date}\" ]]; then\n            # 只删除原始对话，保留摘要文件\n            if grep -q \"摘要\" \"$f\" 2>/dev/null; then\n                count=$((count + 1))\n            else\n                rm -f \"$f\"\n                count=$((count + 1))\n            fi\n        fi\n    done\n    echo \"[archive] 清理了 ${count} 个旧归档\"\n}\n\n# 统计归档\nstats() {\n    local total=$(find \"${SESSIONS_DIR}\" -name \"*.md\" -type f 2>/dev/null | wc -l)\n    local today=$(find \"${SESSIONS_DIR}\" -name \"${TODAY}-*.md\" -type f 2>/dev/null | wc -l)\n    echo \"[archive] 总归档: ${total} | 今日: ${today}\"\n}\n\n# 主逻辑\ncase \"${1:-stats}\" in\n    archive)\n        archive_session \"${2:-unknown}\" \"${3:-manual}\" \"${4:-无摘要}\" \"${5:-无}\" \"${6:-无}\"\n        ;;\n    cleanup)\n        cleanup_old_archives\n        ;;\n    stats)\n        stats\n        ;;\n    *)\n        echo \"用法: $0 {archive|cleanup|stats} [channel] [session_id] [summary] [decisions] [todos]\"\n        ;;\nesac"}],"details":{"status":"completed","exitCode":0,"durationMs":5,"aggregated":"#!/bin/bash\n# session-archive.sh - Session 归档脚本\n# 用途: 将当前/最近的 session 对话归档到 memory/sessions/\n# 调用方式: 手动或 heartbeat 中自动执行\n\nset -euo pipefail\n\nWORKSPACE_DIR=\"/workspace/projects/workspace\"\nMEMORY_DIR=\"${WORKSPACE_DIR}/memory\"\nSESSIONS_DIR=\"${MEMORY_DIR}/sessions\"\nTODAY=$(date +%Y-%m-%d)\nNOW=$(date +%Y%m%d_%H%M%S)\n\nmkdir -p \"${SESSIONS_DIR}\"\n\n# 归档函数\narchive_session() {\n    local channel=\"$1\"\n    local session_id=\"$2\"\n    local summary=\"$3\"\n    local decisions=\"$4\"\n    local todos=\"$5\"\n\n    local archive_file=\"${SESSIONS_DIR}/${TODAY}-${channel}-${session_id}.md\"\n\n    cat > \"${archive_file}\" << EOF\n# Session 归档\n\n- **渠道**: ${channel}\n- **Session ID**: ${session_id}\n- **归档时间**: $(date '+%Y-%m-%d %H:%M:%S %z')\n\n## 对话摘要\n${summary}\n\n## 重要决策\n${decisions}\n\n## 待办事项\n${todos}\n\n---\n*自动归档 by session-archive.sh*\nEOF\n\n    echo \"[archive] 已归档: ${archive_file}\"\n}\n\n# 清理旧归档（保留30天以上的摘要）\ncleanup_old_archives() {\n    local cutoff_date=$(date -d \"30 days ago\" +%Y-%m-%d 2>/dev/null || date -v-30d +%Y-%m-%d 2>/dev/null)\n\n    if [ -z \"${cutoff_date}\" ]; then\n        echo \"[archive] 无法计算截止日期，跳过清理\"\n        return\n    fi\n\n    local count=0\n    for f in \"${SESSIONS_DIR}\"/*.md; do\n        [ -f \"$f\" ] || continue\n        local file_date=$(basename \"$f\" | grep -oP '^\\d{4}-\\d{2}-\\d{2}' || true)\n        if [ -n \"${file_date}\" ] && [[ \"${file_date}\" < \"${cutoff_date}\" ]]; then\n            # 只删除原始对话，保留摘要文件\n            if grep -q \"摘要\" \"$f\" 2>/dev/null; then\n                count=$((count + 1))\n            else\n                rm -f \"$f\"\n                count=$((count + 1))\n            fi\n        fi\n    done\n    echo \"[archive] 清理了 ${count} 个旧归档\"\n}\n\n# 统计归档\nstats() {\n    local total=$(find \"${SESSIONS_DIR}\" -name \"*.md\" -type f 2>/dev/null | wc -l)\n    local today=$(find \"${SESSIONS_DIR}\" -name \"${TODAY}-*.md\" -type f 2>/dev/null | wc -l)\n    echo \"[archive] 总归档: ${total} | 今日: ${today}\"\n}\n\n# 主逻辑\ncase \"${1:-stats}\" in\n    archive)\n        archive_session \"${2:-unknown}\" \"${3:-manual}\" \"${4:-无摘要}\" \"${5:-无}\" \"${6:-无}\"\n        ;;\n    cleanup)\n        cleanup_old_archives\n        ;;\n    stats)\n        stats\n        ;;\n    *)\n        echo \"用法: $0 {archive|cleanup|stats} [channel] [session_id] [summary] [decisions] [todos]\"\n        ;;\nesac","cwd":"/workspace/projects/workspace"},"isError":false,"timestamp":1779487589574}}
