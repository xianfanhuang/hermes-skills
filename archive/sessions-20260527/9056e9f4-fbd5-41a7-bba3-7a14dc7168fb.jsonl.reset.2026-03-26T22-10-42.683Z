n      \"risk_pct\": 5,\n      \"leverage\": 1,\n      \"status\": \"持仓中 - 过夜\",\n      \"sse_index\": 3813.28,\n      \"alert\": \"A50期货今日收涨1.15%，报14474.97点\",\n      \"daily_change\": \"+1.7%\",\n      \"index_close\": 14474.97\n    }\n  ],\n  \"risk_parameters\": {\n    \"stop_loss_per_trade\": \"5%\",\n    \"take_profit_per_trade\": \"15-20%\",\n    \"max_leverage\": 20,\n    \"max_exposure_per_symbol\": \"30%\"\n  },\n  \"focus_signals\": [\n    {\n      \"signal\": \"原油/油气链\",\n      \"strength\": \"强信号\",\n      \"probability\": \">70%\",\n      \"expected_volatility\": \"30%+\",\n      \"symbols\": [\"USO\", \"XLE\", \"XOM\", \"CVX\"]\n    },\n    {\n      \"signal\": \"A股超跌反弹\",\n      \"strength\": \"强信号\",\n      \"probability\": \">70%\",\n      \"support_level\": \"3900-3920点\",\n      \"symbols\": [\"A50\", \"CSI300\"]\n    },\n    {\n      \"signal\": \"光伏设备\",\n      \"strength\": \"中强信号\",\n      \"probability\": \"55-70%\",\n      \"catalyst\": \"特斯拉29亿美元采购中国光伏设备\",\n      \"symbols\": [\"JASO\", \"CSI Solar\"]\n    },\n    {\n      \"signal\": \"人形机器人\",\n      \"strength\": \"中强信号\",\n      \"probability\": \"55-70%\",\n      \"catalyst\": \"宇树科技科创板IPO\",\n      \"symbols\": [\"ROBO\", \"TSLA\"]\n    }\n  ],\n  \"us_options_watchlist\": [\n    {\n      \"symbol\": \"NVDA\",\n      \"price\": 172.70,\n      \"option_volume\": \"359.88万张\",\n      \"strategy\": \"看涨回调买入，看跌对冲\",\n      \"iv_status\": \"高位\"\n    },\n    {\n      \"symbol\": \"TSLA\",\n      \"price\": 391.20,\n      \"option_volume\": \"327.16万张\",\n      \"strategy\": \"事件驱动，波动率交易\",\n      \"iv_status\": \"常年高企\"\n    },\n    {\n      \"symbol\": \"META\",\n      \"price\": 440.50,\n      \"option_volume\": \"86.03万张\",\n      \"strategy\": \"财报跨式期权\",\n      \"iv_status\": \"高位\"\n    }\n  ],\n  \"hk_stocks_watchlist\": [\n    {\n      \"symbol\": \"泡泡玛特\",\n      \"code\": \"09992\",\n      \"price\": 209.60,\n      \"action\": \"观望，等待回撤至200以下\",\n      \"target_price\": 250,\n 