    \n- 80             daily_status = chanlun.analyze_daily_direction(df_daily)\n  81             \n- 82             # 获取30分钟数据找买点\n- 83             df_30m = chanlun.get_kline(symbol, period=\"30min\", count=100)\n+ 96             # 转换为czsc格式\n+ 97             df_daily = df_daily.rename(columns={\n+ 98                 'time': 'dt',\n+ 99                 'open': 'open',\n+100                 'high': 'high',\n+101                 'low': 'low',\n+102                 'close': 'close',\n+103                 'volume': 'vol'\n+104             })\n+105             df_daily['dt'] = pd.to_datetime(df_daily['dt'])\n+106             df_daily = df_daily.sort_values('dt')\n+107             \n+108             # 创建czsc对象\n+109             ka_daily = CZSC(df_daily, Freq.D)\n+110             ext_daily = CzscExtension(ka_daily)\n+111             \n+112             # 判断日线方向\n+113             daily_bi_list = ext_daily.get_bi_list()\n+114             daily_direction = \"up\" if len(daily_bi_list) >= 2 and daily_bi_list[-1]['direction'] == 'up' else \"down\"\n+115             \n+116             # 获取30分钟数据\n+117             df_30m = client.quote_client.get_bars([symbol], period=\"30min\", limit=100)\n  84             if df_30m is None or len(df_30m) < 50:\n+119                 print(f\"⏳ {symbol}: 30分钟数据不足\")\n  85                 continue\n- 86                 \n- 87             buy_signals = chanlun.find_buy_signals(df_30m, df_daily)\n  88             \n+122             df_30m = df_30m.rename(columns={\n+123                 'time': 'dt',\n+124                 'open': 'open',\n+125                 'high': 'high',\n+126                 'low': 'low',\n+127                 'close': 'close',\n+128                 'volume': 'vol'\n+129             })\n+130             df_30m['dt'] = pd.to_datetime(df_30m['dt'])\n+131             df_30m = df_30m.sort_values('dt')\n+132             \n+133             # 创建30分钟czsc对象\n+134             ka_30m = CZSC(df_30m, Freq.F30)\n+135             ext_30m = Czs