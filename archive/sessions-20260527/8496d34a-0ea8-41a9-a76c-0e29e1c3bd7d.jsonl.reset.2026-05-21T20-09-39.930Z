{"type":"message","id":"2a9fab47","parentId":"9b47753d","timestamp":"2026-05-21T01:18:33.009Z","message":{"role":"toolResult","toolCallId":"read:50","toolName":"read","content":[{"type":"text","text":"                print(f\"⏳ {symbol}: 现价 {current_price:.2f} (缠论分析不可用)\")\n                continue\n            \n            # 获取日线数据\n            df_daily = client.get_daily_bars(symbol, limit=100)\n            if df_daily is None or len(df_daily) < 50:\n                print(f\"⏳ {symbol}: 日线数据不足\")\n                continue\n            \n            # 转换为czsc格式\n            df_daily = df_daily.rename(columns={\n                'time': 'dt',\n                'open': 'open',\n                'high': 'high',\n                'low': 'low',\n                'close': 'close',\n                'volume': 'vol'\n            })\n            df_daily['dt'] = pd.to_datetime(df_daily['dt'])\n            df_daily = df_daily.sort_values('dt')\n            \n            # 创建czsc对象\n            ka_daily = CZSC(df_daily, Freq.D)\n            ext_daily = CzscExtension(ka_daily)\n            \n            # 判断日线方向\n            daily_bi_list = ext_daily.get_bi_list()\n            daily_direction = \"up\" if len(daily_bi_list) >= 2 and daily_bi_list[-1]['direction'] == 'up' else \"down\"\n            \n            # 获取30分钟数据\n            df_30m = client.quote_client.get_bars([symbol], period=\"30min\", limit=100)\n            if df_30m is None or len(df_30m) < 50:\n                print(f\"⏳ {symbol}: 30分钟数据不足\")\n                continue\n            \n            df_30m = df_30m.rename(columns={\n                'time': 'dt',\n                'open': 'open',\n                'high': 'high',\n                'low': 'low',\n                'close': 'close',\n                'volume': 'vol'\n            })\n            df_30m['dt'] = pd.to_datetime(df_30m['dt'])\n            df_30m = df_30m.sort_values('dt')\n            \n            # 创建30分钟czsc对象\n            ka_30m = CZSC(df_30m, Freq.F30)\n            ext_30m = CzscExtension(ka_30m)\n            \n            # 查找买点\n            buy_points = ext_30m.find_buy2_points()\n            if not buy_points:\n                buy_points = ext_30m.find_shock_buy_points()\n            \n            # 输出结果\n            direction_emoji = \"📈\" if daily_direction == 'up' else \"📉\"\n            \n            if buy_points:\n                # 找到最佳买点\n\n[118 more lines in file. Use offset=150 to continue.]"}],"isError":false,"timestamp":1779326313007}}
