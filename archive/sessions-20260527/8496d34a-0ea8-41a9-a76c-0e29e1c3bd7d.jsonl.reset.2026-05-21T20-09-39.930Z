y['vol'] * df_daily['close']\n        df_daily = df_daily.sort_values('dt')\n        \n        bars_daily = format_standard_kline(df_daily, Freq.D)\n        ka_daily = CZSC(bars_daily, max_bi_num=1000)\n        ext_daily = CzscExtension(ka_daily)\n        \n        # 获取关键指标\n        bi_list = ext_daily.bi_list\n        zs_list = ext_daily.calc_zs_list()\n        trend = ext_daily.judge_trend()\n        divergence = ext_daily.detect_divergence()\n        \n        # 计算评分要素\n        bi_count = len(bi_list)\n        zs_count = len(zs_list)\n        \n        # 趋势评分\n        trend_score = 0\n        if trend == 'up':\n            trend_score = 3\n        elif trend == 'neutral':\n            trend_score = 1\n        else:\n            trend_score = 0\n        \n        # 结构评分 (笔和中枢越多，结构越清晰)\n        structure_score = min(bi_count / 10, 3) + min(zs_count * 0.5, 2)\n        \n        # 背驰评分\n        divergence_score = 0\n        if divergence.get('divergence'):\n            divergence_score = 2\n        \n        # 距离历史高低点位置 (用于判断性价比)\n        if len(df_daily) > 20:\n            high_20 = df_daily['high'].tail(20).max()\n            low_20 = df_daily['low'].tail(20).min()\n            position_pct = (current_price - low_20) / (high_20 - low_20) if high_20 > low_20 else 0.5\n            # 位置越低越好 (抄底价值)\n            position_score = (1 - position_pct) * 2\n        else:\n            position_score = 0\n        \n        # 总分\n        total_score = trend_score + structure_score + divergence_score + position_score\n        \n        results.append({\n            'symbol': symbol,\n            'name': name,\n            'price': current_price,\n            'trend': trend,\n            'bi_count': bi_count,\n            'zs_count': zs_count,\n            'divergence': divergence.get('divergence', False),\n            'trend_score': trend_score,\n            'structure_score': structure_score,\n            'divergence_score': divergence_score,\n            'position_score': position_score,\n            'total_score': total_score\n        })\n        \n        div_status = \"✓有背驰\" if divergence.get('divergence') else \"✗无背驰\"\n        print(f\"   价格: {current_price:.2f} | 趋势: {trend} | 笔: {bi_count} | 中枢: {zs_count}\")\n        print(f\"   背驰: {div_status} | 综合评分: {total_score:.1f}\")\n        \n    except Exception as e:\n        print(f\"   ❌ 分析失败: {e}\")\n        continue\n\n# 排序并输出结果\nprint(\"\\n\" + \"=\"*70)\nprint(\"📈 交易价值排名\")\nprint(\"=\"*70)\n\nresults.sort(key=lambda x: x['total_score'], reverse=True)\n\nfor i, r in enumerate(results, 1):\n    emoji = \"🥇\" if i == 1 else \"🥈\" if i == 2 else \"🥉\" if i == 3 else \"  \"\n    print(f\"{emoji} #{i} {r['symbol']} ({r['name']})\")\n    print(f\"      价格: {r['price']:.2f} | 趋势: {r['trend']} | 评分: {r['total_score']:.1f}\")\n    print(f\"      笔/中枢: {r['bi_count']}/{r['zs_count']} | 背驰: {'是' if r['divergence'] else '否'}\")\n    print()\n\nif results:\n    best = results[0]\n    print(\"=\"*70)\n    print(f\"🏆 当前最具交易价值标的: {best['symbol']} ({best['name']})\")\n    print(f\"   现价: {best['price']:.2f}\")\n    print(f\"   趋势: {best['trend']}\")\n    print(f\"   综合评分: {best['total_score']:.1f}/10\")\n    print(\"=\"*70)\n\nPYEOF","timeout":120}}],"api":"openai-completions","provider":"coze","model":"kimi-k2-5-260127","usage":{"input":260,"output":1647,"cacheRead":59136,"cacheWrite":0,"totalTokens":61043,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1779326873532}}
